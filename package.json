{
  "name": "l9-meta-injector",
  "version": "4.2.0",
  "description": "L9 meta-injection toolkit for prompt, skill, and kernel metadata",
  "license": "UNLICENSED",
  "author": "Quantum-L9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantum-L9/l9-meta-injector.git"
  },
  "homepage": "https://github.com/Quantum-L9/l9-meta-injector#readme",
  "bugs": {
    "url": "https://github.com/Quantum-L9/l9-meta-injector/issues"
  },
  "keywords": [
    "l9",
    "metadata",
    "meta-injection",
    "artifact-metadata",
    "prompt",
    "skill",
    "kernel",
    "mcp",
    "frontmatter",
    "code-annotation",
    "sidecar",
    "yaml"
  ],
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "examples",
    "scripts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "selfpack": "npm run build && node scripts/selfpack.js",
    "selfpack:update": "npm run build && node scripts/selfpack.js --update",
    "inventory": "npm run build && node scripts/inventory.js",
    "operate": "npm run build && node scripts/operation-cli.js",
    "pipeline": "npm run build && node scripts/pipeline-cli.js",
    "check": "npm run build && node scripts/check-cli.js",
    "apply": "npm run build && node scripts/apply-cli.js",
    "skills": "npm run build && node scripts/skills-cli.js",
    "repository-model": "npm run build && node scripts/repository-model-cli.js",
    "local-source": "npm run build && node scripts/local-source-cli.js",
    "topology:conformance": "node scripts/topology-conformance.js",
    "qualify:corpus": "node scripts/corpus-qualification.js",
    "check:api": "node scripts/check-public-api.js",
    "check:authority": "node scripts/check-architecture-authority.js",
    "check:manifest": "node scripts/generate-architecture-manifest.js --check",
    "manifest:update": "node scripts/generate-architecture-manifest.js",
    "check:dist": "node scripts/check-dist-sync.js",
    "test:packed": "node scripts/test-packed-consumer.js",
    "check:publication": "node scripts/check-publication-readiness.js",
    "validate": "npm run typecheck && npm test && npm run check:api && npm run check:authority && npm run check:manifest && npm run check:dist && npm run selfpack && npm run test:packed && npm run check:release-candidate",
    "prepack": "npm run check:api && npm run check:authority && npm run check:manifest && npm run check:dist && npm run check:release-candidate",
    "prepublishOnly": "npm run validate && npm run check:publication",
    "check:release-candidate": "node scripts/check-release-candidate.js",
    "validate:report": "node scripts/validation-report.js",
    "deps:rebind": "node scripts/deps-rebind.js",
    "semantics:verify": "node scripts/semantics-verify.js"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "^10.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./inventory": {
      "types": "./dist/public/inventory.d.ts",
      "require": "./dist/public/inventory.js",
      "default": "./dist/public/inventory.js"
    },
    "./schema": {
      "types": "./dist/public/schema.d.ts",
      "require": "./dist/public/schema.js",
      "default": "./dist/public/schema.js"
    },
    "./advanced": {
      "types": "./dist/public/advanced.d.ts",
      "require": "./dist/public/advanced.js",
      "default": "./dist/public/advanced.js"
    },
    "./advanced/llm": {
      "types": "./dist/public/llm.d.ts",
      "require": "./dist/public/llm.js",
      "default": "./dist/public/llm.js"
    },
    "./repository-model": {
      "types": "./dist/public/repository_model.d.ts",
      "require": "./dist/public/repository_model.js",
      "default": "./dist/public/repository_model.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "inventory": [
        "dist/public/inventory.d.ts"
      ],
      "schema": [
        "dist/public/schema.d.ts"
      ],
      "advanced": [
        "dist/public/advanced.d.ts"
      ],
      "advanced/llm": [
        "dist/public/llm.d.ts"
      ],
      "repository-model": [
        "dist/public/repository_model.d.ts"
      ]
    }
  },
  "bin": {
    "l9-meta-injector": "scripts/operation-cli.js"
  }
}
