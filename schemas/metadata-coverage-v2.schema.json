{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l9.dev/schemas/metadata-coverage-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_contract",
    "producer_version",
    "repository_id",
    "snapshot",
    "population",
    "subject_content_reads",
    "source_mutation",
    "authority_inspection",
    "index",
    "entries",
    "alias_ambiguities",
    "totals",
    "closure",
    "host_materializability"
  ],
  "properties": {
    "schema": {
      "const": "l9.metadata-coverage/v2"
    },
    "policy_contract": {
      "const": "l9.tracked-carrier-policy/v2"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tree_oid", "object_format"],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree_oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "object_format": {
          "enum": ["sha1", "sha256"]
        }
      }
    },
    "population": {
      "const": "tracked_tree_leaves"
    },
    "subject_content_reads": {
      "const": false
    },
    "source_mutation": {
      "const": "never"
    },
    "authority_inspection": {
      "const": "not_performed"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": {
          "const": "l9.metadata-index/v2"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "metadata-coverage-v2.schema.json#/$defs/entry"
      }
    },
    "alias_ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema", "alias", "ids"],
        "properties": {
          "schema": {
            "const": "l9.namespace-alias/v1"
          },
          "alias": {
            "type": "string"
          },
          "ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^l9\\.path/v2:[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*$"
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_leaves", "indexed", "protected", "unsupported"],
      "properties": {
        "tree_leaves": {
          "type": "integer",
          "minimum": 0
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        },
        "protected": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "closure": {
      "const": "exact_set_verified"
    },
    "host_materializability": {
      "const": "not_assessed"
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "path_bytes_base64",
        "mode",
        "object_type",
        "object_oid",
        "carrier",
        "disposition",
        "reason"
      ],
      "properties": {
        "path": {
          "type": ["string", "null"]
        },
        "path_bytes_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "mode": {
          "enum": ["100644", "100755", "120000", "160000"]
        },
        "object_type": {
          "enum": ["blob", "commit"]
        },
        "object_oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "carrier": {
          "enum": ["hard_skip", "central_manifest", "inventory_only"]
        },
        "disposition": {
          "enum": ["indexed", "protected", "unsupported"]
        },
        "reason": {
          "enum": [
            "index_only",
            "link_as_link",
            "gitlink_as_reference",
            "name_hint_inventory",
            "protected_self",
            "protected_manifest",
            "protected_git_internal",
            "protected_secret",
            "unsupported_path",
            "unsupported_git_entry"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "path_bytes_base64",
        "mode",
        "object_type",
        "object_oid",
        "carrier",
        "disposition",
        "reason",
        "id",
        "content_hash",
        "content_hash_scope"
      ],
      "properties": {
        "path": {
          "type": ["string", "null"]
        },
        "path_bytes_base64": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "mode": {
          "enum": ["100644", "100755", "120000", "160000"]
        },
        "object_type": {
          "enum": ["blob", "commit"]
        },
        "object_oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "carrier": {
          "enum": ["hard_skip", "central_manifest", "inventory_only"]
        },
        "disposition": {
          "enum": ["indexed", "protected", "unsupported"]
        },
        "reason": {
          "enum": [
            "index_only",
            "link_as_link",
            "gitlink_as_reference",
            "name_hint_inventory",
            "protected_self",
            "protected_manifest",
            "protected_git_internal",
            "protected_secret",
            "unsupported_path",
            "unsupported_git_entry"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^l9\\.path/v2:[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*$"
        },
        "content_hash": {
          "const": null
        },
        "content_hash_scope": {
          "const": "not_inspected"
        }
      }
    }
  },
  "description": "Canonical external receipt. Runtime additionally verifies raw-byte identities, one resolver policy, exact-set closure, mode/type/OID evidence, order and index materialization against the immutable census; counts alone are never proof."
}
