{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l9.dev/schemas/metadata-index-record-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "path",
    "path_bytes_base64",
    "carrier",
    "artifact_type",
    "content_kind",
    "content_hash",
    "content_hash_scope",
    "git",
    "metadata"
  ],
  "properties": {
    "schema": {
      "const": "l9.metadata-index/v2"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\\\u0000-\\u001F\\u007F]+$"
    },
    "path_bytes_base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "carrier": {
      "enum": [
        "central_manifest",
        "inventory_only"
      ]
    },
    "artifact_type": {
      "const": "unknown"
    },
    "content_kind": {
      "const": "Unknown"
    },
    "content_hash": {
      "const": null
    },
    "content_hash_scope": {
      "const": "not_inspected"
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "object_type",
        "object_oid",
        "object_format"
      ],
      "properties": {
        "mode": {
          "enum": [
            "100644",
            "100755",
            "120000",
            "160000"
          ]
        },
        "object_type": {
          "enum": [
            "blob",
            "commit"
          ]
        },
        "object_oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_format": {
                "const": "sha1"
              }
            }
          },
          "then": {
            "properties": {
              "object_oid": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "else": {
            "properties": {
              "object_oid": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "160000"
              }
            }
          },
          "then": {
            "properties": {
              "object_type": {
                "const": "commit"
              }
            }
          },
          "else": {
            "properties": {
              "object_type": {
                "const": "blob"
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository_id",
        "legacy_alias"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^l9\\.path/v2:[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*$"
        },
        "repository_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "legacy_alias": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "id"
          ],
          "properties": {
            "schema": {
              "const": "l9.namespace-alias/v1"
            },
            "id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
